{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Ashfall Tauri PoC",
  "version": "0.0.0",
  "identifier": "local.ashfall.tauri-poc",
  "build": {
    "frontendDist": "../../../work/tauri-poc/assets",
    "windows": { "staticVCRuntime": true }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["../../../work/tauri-poc/icon.ico"] }
}
